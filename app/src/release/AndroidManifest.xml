<!-- Release-only overlay: a debug build holds far more memory, so it declares no budget. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <!-- Memory budget for the perceptible state, the state of a bound input method.
             Above the budget the system reclaims pages of this process instead of killing it,
             so the value must not undercut the working set: it is PSS_BUDGET_RELEASE_KB of
             scripts/device-perf-ritual.sh rounded up to whole MiB. Foreground (settings
             screens) and background stay unbudgeted. API 37.2+; older platforms ignore the
             element, so UnusedAttribute is expected. -->
        <memory-budget
            android:maxMb="68"
            android:state="perceptible"
            tools:ignore="UnusedAttribute" />

    </application>

</manifest>
