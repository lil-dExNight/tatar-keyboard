<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest of the instrumentation test APK. The tests run on the SDK's legacy runner
  (android.test.InstrumentationTestRunner), whose classes live in the optional
  android.test.runner shared library on API 24+. Without this uses-library declaration the
  package manager cannot resolve the runner and `am instrument` fails with
  "Unable to find instrumentation info". Applies to the debug test APK only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- LockScreenQuickReplyHelper posts its notification from the test package. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The build injects the regular runner into the first instrumentation element; the later
         self-targeted runners keep helpers out of the keyboard process (QuickReplySelfRunner,
         SpellCheckPerfSelfRunner, FirstGlidePerfSelfRunner). -->
    <instrumentation
        android:name="android.test.InstrumentationTestRunner"
        android:targetPackage="org.tatarkeyboard.ime.debug" />
    <instrumentation
        android:name="rkr.simplekeyboard.inputmethod.latin.QuickReplySelfRunner"
        android:targetPackage="${applicationId}"
        android:label="quick reply self runner" />
    <instrumentation
        android:name="rkr.simplekeyboard.inputmethod.latin.spellcheck.SpellCheckPerfSelfRunner"
        android:targetPackage="${applicationId}"
        android:label="spell check performance self runner" />
    <instrumentation
        android:name="rkr.simplekeyboard.inputmethod.latin.glide.FirstGlidePerfSelfRunner"
        android:targetPackage="${applicationId}"
        android:label="first glide performance self runner" />

    <application>
        <uses-library
            android:name="android.test.runner"
            android:required="false" />
        <activity
            android:name="rkr.simplekeyboard.inputmethod.latin.glide.FirstGlidePerfActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />
        <!-- BackupExportTestDocumentsProvider is declared in the debug app manifest instead:
             an exported DocumentsProvider in this separate test UID would need the
             signature-level MANAGE_DOCUMENTS permission, which the test APK cannot hold. -->
    </application>
</manifest>
