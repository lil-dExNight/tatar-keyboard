<!-- Debug-only components of the gesture recorder: the control screen (the opt-in dialog lives
     here) and the read-only export provider for the share sheet. Both are non-exported and
     absent from the release APK. No permissions are requested. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".latin.glide.recorder.GestureRecorderActivity"
            android:label="Gesture recorder"
            android:exported="false"
            android:theme="@style/platformSettingsTheme" />

        <provider
            android:name=".latin.glide.recorder.GestureRecorderExportProvider"
            android:authorities="${applicationId}.gesture_recorder_export"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
