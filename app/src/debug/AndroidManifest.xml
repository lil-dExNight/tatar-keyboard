<!-- Debug-only components: the gesture recorder control screen (the opt-in dialog lives here),
     its read-only export provider for the share sheet, and the backup export test documents
     provider. All are absent from the release APK. No permissions are requested; the documents
     provider is exported only because DocumentsProvider requires it, and stays guarded by the
     signature-level MANAGE_DOCUMENTS permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".latin.glide.recorder.GestureRecorderApp">
        <activity
            android:name=".latin.glide.recorder.GestureRecorderActivity"
            android:label="Gesture recorder"
            android:exported="false"
            android:theme="@style/platformSettingsTheme" />

        <provider
            android:name=".latin.glide.recorder.GestureRecorderExportProvider"
            android:authorities="${applicationId}.gesture_recorder_export"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Test-only documents provider for BackupExportDocumentDeviceTest. DocumentsProvider
             requires all three flags in attachInfo: exported, grantUriPermissions, and
             MANAGE_DOCUMENTS as the read/write permission (android:permission sets both). The
             instrumentation runs in this app's UID, and same-UID callers bypass the permission
             check, so the real resolver round trip works. No other app can hold that
             signature-level permission, so the provider stays unreachable for everything else. -->
        <provider
            android:name=".latin.settings.backup.BackupExportTestDocumentsProvider"
            android:authorities="rkr.simplekeyboard.inputmethod.test.backup-export"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>

</manifest>
