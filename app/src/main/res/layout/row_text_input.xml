<!-- The only text-input row of the app: the personal-dictionary search field and the
     "Add word…" dialog field. The three privacy flags are set in code
     (SettingsHostActivity) for both fields, not here: words the user puts into the
     personal dictionary must not be learned by another keyboard or picked up by autofill. -->
<EditText xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_text_input"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@null"
    android:filterTouchesWhenObscured="true"
    android:textSize="17sp"
    android:fontFamily="sans-serif"
    android:textColor="@color/app_text_primary"
    android:textColorHint="@color/app_text_secondary"
    android:maxLines="1"
    android:singleLine="true" />
