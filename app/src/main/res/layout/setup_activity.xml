<!-- Two-step onboarding. Classic View/XML on purpose: no new dependencies,
     system Material widgets under platformSettingsTheme. iOS-style grouped
     table: flat cards on a grouped-table field, 34sp large title, system-blue
     filled actions, all colored by the shared app_* design tokens. View ids
     are referenced by SetupActivity.kt; do not rename them. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_screen_bg"
    android:filterTouchesWhenObscured="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- iOS large title: 34sp sans-serif bold (inline, no AppText.* dep) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/english_ime_name"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/setup_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="@string/setup_subtitle"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <!-- Step 1 card: enable the keyboard in system settings -->
        <LinearLayout
            android:id="@+id/setup_step1_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/app_card_bg"
            android:padding="16dp">

            <!-- Live region: TalkBack announces the pending→done change on
                 its own when updateStepStates swaps text/description. -->
            <TextView
                android:id="@+id/setup_step1_status"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/setup_step1_number"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_step1_title"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <!-- Text is set in SetupActivity: the string takes the
                     keyboard name as a format argument. -->
                <TextView
                    android:id="@+id/setup_step1_instruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?android:attr/textAppearanceSmall" />

                <!-- Pre-arms the standard data-collection warning the system
                     shows when the enable toggle is flipped. -->
                <TextView
                    android:id="@+id/setup_step1_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/setup_step1_note"
                    android:textAppearance="?android:attr/textAppearanceSmall" />

                <Button
                    android:id="@+id/setup_step1_button"
                    android:filterTouchesWhenObscured="true"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/setup_button_filled"
                    android:stateListAnimator="@null"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    android:textColor="@color/setup_button_text"
                    android:text="@string/setup_step1_button" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 2 card: select the keyboard via the system picker -->
        <LinearLayout
            android:id="@+id/setup_step2_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:background="@drawable/app_card_bg"
            android:padding="16dp">

            <TextView
                android:id="@+id/setup_step2_status"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/setup_step2_number"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_step2_title"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/setup_step2_instruction"
                    android:textAppearance="?android:attr/textAppearanceSmall" />

                <Button
                    android:id="@+id/setup_step2_button"
                    android:filterTouchesWhenObscured="true"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/setup_button_filled"
                    android:stateListAnimator="@null"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    android:textColor="@color/setup_button_text"
                    android:text="@string/setup_step2_button" />
            </LinearLayout>
        </LinearLayout>

        <!-- Done block: both steps complete. Live region so TalkBack
             announces the block's content when it appears (gone→visible). -->
        <LinearLayout
            android:id="@+id/setup_done_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone">

            <TextView
                android:id="@+id/setup_done_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_done_title"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_done_hint"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <!-- Try-it field in its own card: the freshly selected keyboard
                 opens here. The hint is also
                 the field's TalkBack label (no contentDescription on an
                 EditText). -->
            <EditText
                android:id="@+id/setup_test_field"
                android:filterTouchesWhenObscured="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/app_card_bg"
                android:padding="16dp"
                android:hint="@string/setup_test_field_hint"
                android:imeOptions="actionDone"
                android:inputType="text" />

            <!-- Borderless secondary: system-blue text, iOS accent. -->
            <Button
                android:id="@+id/setup_done_button"
                android:filterTouchesWhenObscured="true"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/app_accent"
                android:textAllCaps="false"
                android:text="@string/setup_done_button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
