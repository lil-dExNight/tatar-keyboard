<rkr.simplekeyboard.inputmethod.latin.InputView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/inputViewStyle">
    <LinearLayout
        android:id="@+id/keyboard_stack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="bottom">
        <ViewStub
            android:id="@+id/suggestion_strip_stub"
            android:inflatedId="@+id/suggestion_strip_view"
            android:layout="@layout/suggestion_strip"
            android:layout_width="match_parent"
            android:layout_height="44dp" />
        <ViewStub
            android:id="@+id/emoji_search_stub"
            android:inflatedId="@+id/emoji_search_view"
            android:layout="@layout/emoji_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <rkr.simplekeyboard.inputmethod.keyboard.MainKeyboardView
            android:id="@+id/keyboard_view"
            android:layoutDirection="ltr"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <ViewStub
            android:id="@+id/emoji_panel_stub"
            android:inflatedId="@+id/emoji_panel_view"
            android:layout="@layout/emoji_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</rkr.simplekeyboard.inputmethod.latin.InputView>
