<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="KeyboardTheme.Tatar">
        <item name="inputViewStyle">@style/InputView</item>
        <item name="keyboardStyle">@style/Keyboard.Tatar</item>
        <item name="keyboardViewStyle">@style/KeyboardView.Tatar</item>
        <item name="mainKeyboardViewStyle">@style/MainKeyboardView.Tatar</item>
        <item name="moreKeysKeyboardStyle">@style/MoreKeysKeyboard.Tatar</item>
        <item name="moreKeysKeyboardViewStyle">@style/MoreKeysKeyboardView.Tatar</item>
        <item name="functionalTextColor">@color/ios_key_functional_text_color</item>
        <!-- M3 (docs/APPLE-UX-2026-09-25.md): iOS draws the more-keys panel on the KEY
             surface (white in light, key grey in dark), not on a second keyboard grey. -->
        <item name="popupPanelBackgroundColor">@color/ios_key_normal</item>
        <item name="keyPressedBackgroundColor">@color/ios_key_normal_pressed</item>
        <item name="keyNormalBackgroundColor">@color/ios_key_normal</item>
        <item name="emojiPanelBackgroundColor">@color/ios_keyboard_background</item>
        <item name="emojiPanelFunctionalKeyColor">@color/ios_key_functional</item>
        <item name="suggestionEmphasisColor">@color/app_accent</item>
    </style>
    <style
        name="Keyboard.Tatar"
        parent="Keyboard"
    >
    </style>
    <style
        name="KeyboardView.Tatar"
        parent="KeyboardView"
    >
        <item name="android:background">@color/ios_keyboard_background</item>
        <item name="keyBackground">@drawable/ios_key_normal</item>
        <item name="functionalKeyBackground">@drawable/ios_key_functional</item>
        <item name="spacebarBackground">@drawable/ios_key_spacebar</item>
        <item name="keyTypeface">normal</item>
        <item name="keyTextColor">@color/ios_key_text_color</item>
        <item name="keyTextInactivatedColor">@color/ios_key_text_inactive_color</item>
        <item name="actionKeyTextColor">@color/ios_key_action_text_color</item>
        <item name="keyHintLetterColor">@color/ios_key_hint_color</item>
        <item name="keyHintLabelColor">@color/ios_key_text_inactive_color</item>
        <item name="keyShiftedLetterHintInactivatedColor">@color/ios_key_text_inactive_color</item>
        <item name="keyShiftedLetterHintActivatedColor">@color/ios_key_text_color</item>
        <item name="keyPreviewTextColor">@color/ios_key_text_color</item>
    </style>
    <style
        name="MainKeyboardView.Tatar"
        parent="KeyboardView.Tatar"
    >
        <item name="keyPreviewBackground">@drawable/ios_key_preview_background</item>
        <item name="keyPreviewHeight">@dimen/config_key_preview_height_lxx</item>
        <item name="keyPreviewWidth">@dimen/config_key_preview_width_lxx</item>
        <item name="keyPreviewOffset">@dimen/config_key_preview_offset_lxx</item>
        <item name="languageOnSpacebarTextColor">@color/ios_key_text_inactive_color</item>
        <item name="glideTrailColor">@color/ios_glide_trail</item>
    </style>
    <style
        name="MoreKeysKeyboard.Tatar"
        parent="Keyboard.Tatar"
        >
        <item name="keyboardTopPadding">0%p</item>
        <item name="keyboardBottomPadding">0%p</item>
        <item name="horizontalGap">0%p</item>
    </style>
    <style
        name="MoreKeysKeyboardView.Tatar"
        parent="KeyboardView.Tatar"
        >
        <item name="android:background">@drawable/ios_popup_panel_background</item>
        <item name="keyBackground">@drawable/ios_popup_key_background</item>
        <item name="keyTypeface">normal</item>
        <item name="verticalCorrection">@dimen/config_more_keys_keyboard_vertical_correction</item>
    </style>
</resources>
