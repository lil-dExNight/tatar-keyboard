<!-- Onboarding strings, English base. The screen title shows the
     brand via @string/english_ime_name directly in the layout — the brand
     name is never hardcoded in these strings. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="setup_subtitle">Two quick steps to start typing in Tatar</string>

    <string name="setup_step1_number" translatable="false">1</string>
    <string name="setup_step2_number" translatable="false">2</string>
    <string name="setup_step_done_mark" translatable="false">✓</string>

    <!-- Spoken (TalkBack) descriptions for the step status marks. -->
    <string name="setup_step_status_done">Step done</string>
    <string name="setup_step_status_pending">Step not done yet</string>

    <!-- Shown only if the device has no input-method settings screen. -->
    <string name="setup_error_no_settings">Open Settings and turn on this keyboard in the keyboard list manually</string>

    <string name="setup_step1_title">Enable the keyboard</string>
    <string name="setup_step1_instruction">Turn on “<xliff:g id="KEYBOARD_NAME" example="Tatar Keyboard">%s</xliff:g>” in the system keyboard list</string>
    <!-- Pre-arms the standard data-collection warning Android shows when the
         enable toggle is flipped; the offline promise is the core product fact. -->
    <string name="setup_step1_note">Android shows this warning for every third-party keyboard. This one works fully offline: it has no INTERNET permission, so nothing you type ever leaves the device.</string>
    <string name="setup_step1_button">Enable keyboard</string>

    <string name="setup_step2_title">Select the keyboard</string>
    <string name="setup_step2_instruction">Choose this keyboard as your current input method</string>
    <string name="setup_step2_button">Select keyboard</string>

    <string name="setup_done_title">Done!</string>
    <string name="setup_done_hint">Glide typing works too: slide across the letters without lifting your finger</string>
    <!-- Hint doubles as the TalkBack label of the try-it field. The word is
         Tatar on purpose in every locale — it is the product's point. -->
    <string name="setup_test_field_hint">Try it: slide across “сәләм”</string>
    <string name="setup_done_button">Open settings</string>
</resources>
