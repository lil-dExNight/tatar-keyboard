<resources>
    <!-- Locale display name exceptions.
         For each exception, there should be related string resources for display name that may have
         explicit keyboard layout. The string resource name must be "locale_name_<locale>". Please
         refer to strings.xml for these resources. -->
    <string-array name="locale_exception_keys">
        <item>en_US</item>
        <item>tt_RU</item>
    </string-array>

    <!-- Locale whose name should be displayed in Locale.ROOT. Empty since the locale slice
         (phase 3b): no shipped locale needs a root-locale name. -->
    <string-array name="locale_displayed_in_root_locale">
    </string-array>

    <!-- Predefined keyboard layouts for additional subtype. Roadmap phase 1 (T4,
         2026-09-22): bepo/azerty/dvorak/colemak/workman/pcqwerty were cut together
         with their layout XML — locales ship tt/ru/en layouts only. -->
    <string-array name="predefined_layouts">
        <item>qwerty</item>
        <item>qwertz</item>
        <item>abc</item>
    </string-array>
    <!-- Predefined keyboard layout display names -->
    <string-array name="predefined_layout_display_names">
        <item>QWERTY</item>
        <item>QWERTZ</item>
        <item>ABC</item>
    </string-array>
</resources>
