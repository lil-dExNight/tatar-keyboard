<!-- iOS-style typography for app screens. Definitions only; screens apply these
     in later waves. Uses platform sans-serif (Roboto), never SF Pro. -->
<resources>
    <!-- List-row / cell text: 17sp. -->
    <style name="AppText.Cell" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Grouped-section header: 13sp uppercase, secondary colour. -->
    <style name="AppText.SectionHeader" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- Screen large title: 34sp bold. -->
    <style name="AppText.LargeTitle" parent="">
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

</resources>
