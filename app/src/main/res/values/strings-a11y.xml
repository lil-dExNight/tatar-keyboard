<!-- Spoken descriptions for TalkBack (base: English). Names follow the AOSP
     strings-talkback-descriptions.xml convention (spoken_*) so any future
     comparison with LatinIME maps one-to-one. Consumed by KeyDescriptionMapper. -->
<resources>
    <!-- Tatar letters (lowercase); uppercase is built via spoken_description_upper_case. -->
    <string name="spoken_letter_04d9">Tatar schwa</string>
    <string name="spoken_letter_04e9">Tatar o</string>
    <string name="spoken_letter_04af">Tatar u</string>
    <string name="spoken_letter_0497">Tatar zhe</string>
    <string name="spoken_letter_04a3">Tatar en</string>
    <string name="spoken_letter_04bb">Tatar he</string>

    <!-- Template for uppercase letters: "Capital <lowercase description>". -->
    <string name="spoken_description_upper_case">Capital %s</string>

    <!-- Shift key, per keyboard element state. -->
    <string name="spoken_description_shift">Shift</string>
    <string name="spoken_description_shift_shifted">Shift on</string>
    <string name="spoken_description_caps_lock">Caps lock on</string>
    <string name="spoken_description_symbols_shift">More symbols</string>
    <string name="spoken_description_symbols_shift_shifted">Symbols</string>

    <!-- Other functional keys. -->
    <string name="spoken_description_tab">Tab</string>
    <string name="spoken_description_delete">Delete</string>
    <!-- Spacebar: always includes the current input language, the way the
         visual spacebar hint does ("Space, Татарча"). %s is the language
         display name rendered in its own locale. -->
    <string name="spoken_description_space_language">Space, %s</string>
    <string name="spoken_description_return">Enter</string>
    <string name="spoken_description_search">Search</string>
    <string name="spoken_description_action_go">Go</string>
    <string name="spoken_description_action_send">Send</string>
    <string name="spoken_description_action_next">Next</string>
    <string name="spoken_description_action_previous">Previous</string>
    <string name="spoken_description_action_done">Done</string>
    <string name="spoken_description_to_symbol">Symbols</string>
    <string name="spoken_description_to_alpha">Letters</string>
    <string name="spoken_description_language_switch">Switch language</string>
    <string name="spoken_description_emoji">Emoji</string>
    <string name="spoken_description_settings">Settings</string>
    <string name="spoken_description_unknown">Unknown</string>

    <!-- Long-press (moreKeys) panel open/close announcements (AOSP naming). -->
    <string name="spoken_open_more_keys_keyboard">Alternative characters are available</string>
    <string name="spoken_close_more_keys_keyboard">Alternative characters are dismissed</string>

    <!-- Shift-mode change announcements (AOSP naming). -->
    <string name="spoken_description_shiftmode_on">Shift enabled</string>
    <string name="spoken_description_shiftmode_locked">Caps lock enabled</string>
    <string name="spoken_description_shiftmode_off">Shift disabled</string>

    <!-- Announced when word suggestions become available; %s is the joined suggestion list. -->
    <string name="spoken_suggestions_available">Suggestions available: %s</string>

    <!-- Emoji-panel category tab names (TalkBack). The emoji cells themselves carry the sequence
         as their contentDescription (the phase ships no emoji-name database); only the tabs and the
         two functional keys ("АБВ" reuses spoken_description_to_alpha, delete reuses
         spoken_description_delete) are named. -->
    <string name="spoken_emoji_category_recent">Recently used</string>
    <string name="spoken_emoji_category_smileys">Smileys and emotion</string>
    <string name="spoken_emoji_category_people">People and body</string>
    <string name="spoken_emoji_category_animals">Animals and nature</string>
    <string name="spoken_emoji_category_food">Food and drink</string>
    <string name="spoken_emoji_category_travel">Travel and places</string>
    <string name="spoken_emoji_category_activities">Activities</string>
    <string name="spoken_emoji_category_objects">Objects</string>
    <string name="spoken_emoji_category_symbols">Symbols</string>
    <string name="spoken_emoji_category_flags">Flags</string>

    <!-- The search view's visible hint; also the TalkBack description of the panel's search cell. -->
    <string name="emoji_search_hint">Search emoji</string>
    <string name="emoji_search_no_results">Nothing found</string>
    <string name="emoji_search_close">Close search</string>
</resources>
