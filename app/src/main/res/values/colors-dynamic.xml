<!-- Fallback tier of the dynamic theme (KeyboardTheme.TatarDynamic): every dyn_* color is a
     plain alias of the default palette, so below API 31 the dynamic theme renders the default
     Tatar palette wholesale — colors, night split and any future retune of it. The code gate
     (DynamicThemePalette) normally swaps the whole style before this tier is ever painted;
     the aliases are the structural safety net and the default configuration the resource
     linker requires. The v31 tiers map the same names to the framework system colors. -->
<resources>
    <color name="dyn_keyboard_background">@color/ios_keyboard_background</color>
    <color name="dyn_key_normal">@color/ios_key_normal</color>
    <color name="dyn_key_normal_pressed">@color/ios_key_normal_pressed</color>
    <color name="dyn_key_functional">@color/ios_key_functional</color>
    <color name="dyn_key_functional_pressed">@color/ios_key_functional_pressed</color>
    <color name="dyn_key_checked">@color/ios_key_checked</color>
    <color name="dyn_key_sticky_on">@color/ios_key_sticky_on</color>
    <color name="dyn_key_spacebar">@color/ios_key_spacebar</color>
    <color name="dyn_key_spacebar_pressed">@color/ios_key_spacebar_pressed</color>
    <color name="dyn_key_shadow">@color/ios_key_shadow</color>
    <color name="dyn_popup_key_pressed">@color/ios_popup_key_pressed</color>
    <color name="dyn_key_text_color">@color/ios_key_text_color</color>
    <color name="dyn_key_functional_text_color">@color/ios_key_functional_text_color</color>
    <color name="dyn_key_action_fill">@color/ios_key_action_fill</color>
    <color name="dyn_key_action_text_color">@color/ios_key_action_text_color</color>
    <color name="dyn_key_text_inactive_color">@color/ios_key_text_inactive_color</color>
    <color name="dyn_key_hint_color">@color/ios_key_hint_color</color>
    <color name="dyn_suggestion_emphasis">@color/ios_suggestion_emphasis</color>
    <color name="dyn_glide_trail">@color/ios_glide_trail</color>
</resources>
