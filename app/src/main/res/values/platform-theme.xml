<resources>
    <style name="platformSettingsTheme" parent="@android:style/Theme.Material.Light.LightStatusBar" />
    <!-- S2 (docs/APPLE-UX-2026-09-25.md): iOS alert styling on the platform dialog — card
         surface with a 13dp radius, a CENTERED 17sp semibold title, and accent, non-shouting
         buttons. NOT iOS: the full-width STACKED button bar, which lives in the framework's
         dialog layout and cannot be restyled by a theme; changing it would mean replacing every
         AlertDialog in the app with a custom view (and re-pinning their source contracts).
         Recorded as a deliberate partial in the stage-B report. -->
    <style name="platformDialogTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog">
        <item name="android:windowBackground">@drawable/app_dialog_bg</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:textColorPrimary">@color/app_text_primary</item>
        <item name="android:windowTitleStyle">@style/AppDialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
    </style>

    <style name="AppDialogTitle" parent="@android:style/TextAppearance.DeviceDefault.DialogWindowTitle">
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="AppDialogButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/app_accent</item>
    </style>

    <!-- SettingsHostActivity: platformSettingsTheme without the ActionBar —
         the screens draw their own 34sp large title (IOS-REDESIGN.md S1.1).
         Defined once: the parent and colors resolve their night variants at
         runtime. windowBackground avoids a launch flash on the grouped field. -->
    <style name="settingsHostTheme" parent="@style/platformSettingsTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_screen_bg</item>
    </style>
</resources>
