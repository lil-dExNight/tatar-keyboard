<resources>
    <integer name="config_key_repeat_start_timeout">400</integer>
    <integer name="config_key_repeat_interval">50</integer>

    <integer name="config_ignore_alt_code_key_timeout">350</integer>

    <!-- TODO: consolidate key preview linger timeout with the above animation parameters. -->
    <integer name="config_key_preview_linger_timeout">53</integer>

    <bool name="config_default_vibration_enabled">true</bool>

    <integer name="config_default_longpress_key_timeout">300</integer>
    <integer name="config_max_longpress_timeout">700</integer>
    <integer name="config_min_longpress_timeout">100</integer>
    <integer name="config_longpress_timeout_step">10</integer>
    <integer name="config_max_more_keys_column">5</integer>

    <!-- Long pressing shift will invoke caps-lock if > 0, never invoke caps-lock if == 0 -->
    <integer name="config_longpress_shift_lock_timeout">1200</integer>

    <integer name="config_language_on_spacebar_final_alpha">255</integer>
    <dimen name="config_language_on_spacebar_horizontal_margin">1dp</dimen>

    <integer name="config_keyboard_grid_width">32</integer>
    <integer name="config_keyboard_grid_height">16</integer>
    <!-- Key detection hysteresis distance while sliding input from a modifier key is active.
         AOSP LatinIME and HeliBoard both ship 8.0dp; the value was dropped when Simple Keyboard
         was forked, so the attribute defaulted to 0.0f and every pixel of movement changed the
         key mid-slide. -->
    <dimen name="config_key_hysteresis_distance_for_sliding_modifier">8.0dp</dimen>
    <!-- How far a pointer that went down on a modifier key (?123, shift) must travel from its
         touch-down point before it may leave that key. Below this it is a tap with finger tremor,
         not sliding input. Chosen above the platform's 8dp touch slop and well below the ~21dp of
         the shortest deliberate slide measured on a 440dpi phone; see
         docs/SYMBOL-KEY-EDGE-FIX.md. -->
    <dimen name="config_sliding_modifier_slop">10.0dp</dimen>
    <dimen name="config_touch_noise_threshold_distance">12.6dp</dimen>
    <integer name="config_touch_noise_threshold_time">40</integer>

    <!-- Common keyboard configuration. -->
    <dimen name="config_keyboard_vertical_correction">0.0dp</dimen>

    <!-- Bottom offset -->
    <integer name="config_max_bottom_offset_portrait">100</integer>
    <integer name="config_min_bottom_offset_portrait">0</integer>
    <integer name="config_bottom_offset_step">1</integer>
</resources>
