<resources>
    <color name="ic_launcher_background">#FEFEFE</color>

    <!-- Color resources for iOS-style Tatar theme (light). -->
    <color name="ios_keyboard_background">#D4D6DD</color>
    <color name="ios_keyboard_background_secondary">#C7CAD2</color>
    <color name="ios_key_normal">#FFFFFF</color>
    <color name="ios_key_normal_pressed">#C8CDD4</color>
    <color name="ios_key_functional">#B3B7C0</color>
    <color name="ios_key_functional_pressed">#FFFFFF</color>
    <color name="ios_key_checked">#A2A6B0</color>
    <color name="ios_key_spacebar">#FFFFFF</color>
    <color name="ios_key_spacebar_pressed">#C8CDD4</color>
    <color name="ios_key_shadow">#40000000</color>
    <!-- Slide-to-select highlight on the more-keys panel: must clearly differ
         from ios_keyboard_background_secondary (the panel fill). -->
    <color name="ios_popup_key_pressed">#A2A6B0</color>
    <color name="ios_key_text_color">#000000</color>
    <color name="ios_key_functional_text_color">#3C3C43</color>
    <color name="ios_key_text_inactive_color">#70000000</color>
    <color name="ios_key_hint_color">#90000000</color>
    <!-- Glide trail (P7-5 recolor, 2026-09-25): near-white iOS systemGray6, Gboard-style.
         Drawn at ≤40 % alpha (GlideTrail.MAX_ALPHA), so over the white keys it is a soft
         sheen and over the #D4D6DD background a lighter ribbon; in the dark theme the same
         near-white reads clearly against #2C2C2C — one value serves both themes. -->
    <color name="ios_glide_trail">#F2F2F7</color>

    <!-- Color resources for iOS-style app screens (light). App-screen palette,
         kept separate from the keyboard ios_* colors above. -->
    <color name="app_screen_bg">#F2F2F7</color>
    <color name="app_card_bg">#FFFFFF</color>
    <color name="app_text_primary">#000000</color>
    <color name="app_text_secondary">#8A8A8E</color>
    <color name="app_separator">#C6C6C8</color>
    <color name="app_accent">#007AFF</color>
    <color name="app_accent_pressed">#0A6CD9</color>
    <color name="app_accent_disabled">#66007AFF</color>
    <color name="app_switch_on">#34C759</color>
    <color name="app_switch_off">#E9E9EA</color>
 </resources>
