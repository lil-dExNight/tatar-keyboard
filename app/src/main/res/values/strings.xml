<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Option to provide vibrate/haptic feedback on keypress -->
    <string name="vibrate_on_keypress">Vibrate on keypress</string>

    <!-- Option to play back sound on keypress in soft keyboard -->
    <string name="sound_on_keypress">Sound on keypress</string>

    <!-- Option to control whether or not to show a popup with a larger font on each key press. -->
    <string name="popup_on_keypress">Popup on keypress</string>

    <!-- Settings screen title for preferences [CHAR LIMIT=33]-->
    <string name="settings_screen_preferences">Preferences</string>
    <!-- Settings screen title for key press preferences [CHAR LIMIT=33]-->
    <string name="settings_screen_key_press">Key press</string>
    <!-- Settings screen title for appearance preferences [CHAR LIMIT=33] -->
    <string name="settings_screen_appearance">Appearance</string>
    <!-- Settings screen title for keyboard theme settings [CHAR LIMIT=33] -->
    <string name="settings_screen_theme">Theme</string>
    <!-- Spoken description of the back button on the settings screens [CHAR LIMIT=33] -->
    <string name="settings_back">Back</string>

    <!-- Units abbreviation for the duration (milliseconds) [CHAR LIMIT=10] -->
    <string name="abbreviation_unit_milliseconds"><xliff:g id="MILLISECONDS">%d</xliff:g>ms</string>
    <!-- The text that represents the current settings value is the system default [CHAR LIMIT=25] -->
    <string name="settings_system_default">System default</string>

    <!-- Option to enable auto capitalization of sentences -->
    <string name="auto_cap">Auto-capitalization</string>
    <!-- Description for option to enable auto capitalization of sentences -->
    <string name="auto_cap_summary">Capitalize the first word of each sentence</string>

    <!-- Preference for input language selection -->
    <string name="select_language">Languages</string>
    <string name="select_language_description" translatable="false">tt_RU:tatar;ru:russian;en_US:qwerty</string>
    <string name="pref_keyboard_color_description" translatable="false">#ECEFF1</string>

    <!-- Description for English (US) keyboard subtype [CHAR LIMIT=25]
         (US) should be an abbreviation of United States to fit in the CHAR LIMIT. -->
    <string name="locale_name_en_US">English (US)</string>
    <!-- Description for Tatar keyboard subtype [CHAR LIMIT=25]
         Endonym shown fixed on any system language. -->
    <string name="locale_name_tt_RU" translatable="false">Татарча</string>
    <!-- Description for a keyboard layout listing the language and layout name.
         A pure "%1$s (%2$s)" format template — nothing to translate. -->
    <string name="subtype_generic_layout" translatable="false"><xliff:g id="LANGUAGE_NAME" example="English (US)">%1$s</xliff:g> (<xliff:g id="LAYOUT" example="QWERTY">%2$s</xliff:g>)</string>

    <string name="keyboard_theme_tatar" translatable="false">Tatar</string>

    <!-- Title of the button to add a language in the settings dialog [CHAR LIMIT=15] -->
    <string name="add">Add</string>
    <!-- Title of the button to remove a language in the settings dialog [CHAR LIMIT=15] -->
    <string name="remove">Remove</string>

    <!-- Title of the settings for keypress vibration duration [CHAR LIMIT=35] -->
    <!-- Title of the settings for keypress sound volume [CHAR LIMIT=35] -->
    <string name="prefs_keypress_sound_volume_settings">Keypress sound volume</string>
    <!-- Title of the settings for key long press delay [CHAR LIMIT=35] -->
    <string name="prefs_key_longpress_timeout_settings">Key long press delay</string>

    <!-- Title of the button to revert to the default value of the device in the settings dialog [CHAR LIMIT=15] -->
    <string name="button_default">Default</string>

    <string translatable="false" name="abbreviation_unit_percent"><xliff:g id="PERCENTS">%d</xliff:g>%%</string>
    <string translatable="false" name="abbreviation_unit_dp"><xliff:g id="DENSITY_INDEPENDENT_PIXELS">%d</xliff:g> dp</string>

    <string name="prefs_keyboard_height_settings">Keyboard height</string>
    <string name="prefs_bottom_offset_portrait_settings">Bottom offset</string>
    <string name="keyboard_color">Set custom keyboard color</string>
    <string name="show_special_chars">Show special characters</string>
    <!-- Description for option to show extra characters; only affects layouts with extra
         character variants (e.g. QWERTY), not the Tatar or Russian layouts -->
    <string name="show_special_chars_summary">Extra symbols on some layouts (QWERTY and others)</string>
    <!-- Settings screen title for key press feedback summaries [CHAR LIMIT=65] -->
    <string name="vibrate_on_keypress_summary">Short vibration on every key press</string>
    <string name="sound_on_keypress_summary">Click sound on every key press</string>
    <string name="popup_on_keypress_summary">Show the enlarged character above the key (off in password fields)</string>
    <string name="show_number_row_summary">Extra row with digits above the letters</string>
    <string name="show_language_switch_key">Show language switch key</string>
    <!-- Description for option to show the language switch key -->
    <string name="show_language_switch_key_summary">Key for switching between keyboard languages</string>
    <string name="pref_use_on_screen">Show on-screen keyboard</string>
    <string name="pref_use_on_screen_summary">Show on-screen keyboard while using physical keyboard</string>
    <string name="pref_enable_ime_switch">Switch to other keyboards</string>
    <!-- Description for option to also switch to other input methods with the language key -->
    <string name="pref_enable_ime_switch_summary">The language key also switches to other keyboard apps</string>
    <string name="show_number_row">Show separate number row</string>
    <string name="show_emoji_key">Show emoji key</string>
    <!-- Description for option to show the emoji key next to the space bar -->
    <string name="show_emoji_key_summary">Opens the emoji panel: a key of its own next to the space bar, or a long press on the comma key when the language switch key is shown</string>
    <string name="space_swipe">Space swipe cursor move</string>
    <!-- Description for option to move the cursor by swiping on the space bar -->
    <string name="space_swipe_summary">Swipe the space bar to move the cursor</string>
    <string name="delete_swipe">Delete swipe</string>
    <!-- Description for option to delete more text by swiping on the delete key -->
    <string name="delete_swipe_summary">Swipe the delete key to delete more text</string>
    <!-- Option to show word suggestions above the keyboard while typing -->
    <string name="tatar_suggestions">Word suggestions</string>
    <!-- Description for the word suggestions option -->
    <string name="tatar_suggestions_summary">Show suggested and predicted words above the keyboard as you type, in Tatar and in Russian</string>
    <!-- Title of the one-time dialog offering to turn word suggestions on -->
    <string name="tatar_suggestions_offer_title">Turn on word suggestions?</string>
    <!-- Body of the one-time dialog offering to turn word suggestions on -->
    <string name="tatar_suggestions_offer_message">Suggested and predicted words can appear above the keyboard as you type, in Tatar and in Russian. The word lists stay on your device and no internet connection is used.</string>
    <!-- Button that turns word suggestions on -->
    <string name="tatar_suggestions_offer_enable">Turn on</string>
    <!-- Button that declines the offer to turn word suggestions on -->
    <string name="tatar_suggestions_offer_dismiss">Not now</string>
    <!-- Message shown once when word suggestions could not be turned on -->
    <string name="tatar_suggestions_unavailable">Word suggestions could not be turned on right now. You can try again later.</string>
    <!-- Option to replace a misspelled word with a dictionary word when a separator is typed -->
    <string name="tatar_autocorrect">Autocorrect words</string>
    <!-- Description for the autocorrection option. Says plainly that text already typed is changed and how to undo it. -->
    <string name="tatar_autocorrect_summary">Fix a misspelled word when you type a space or punctuation. Press backspace right after to get back what you typed.</string>
    <!-- Option to show a matching emoji in the suggestion strip after a finished word -->
    <string name="emoji_suggestions">Emoji suggestions</string>
    <!-- Description for the emoji suggestions option. Says plainly that tapping the emoji only adds it and never changes the typed word. -->
    <string name="emoji_suggestions_summary">Show a matching emoji above the keyboard when you finish a word, in Tatar and in Russian. Tapping it only adds the emoji — the typed word stays.</string>
    <!-- Option to remember words the user types and suggest them later -->
    <string name="personal_dictionary">Personal dictionary</string>
    <!-- Description for the personal dictionary option. Says plainly that words are saved on the device and that turning the option off keeps what was already saved. -->
    <string name="personal_dictionary_summary">Remember words you type and suggest them later. Saved on this device only. Turning this off keeps what is already saved — erase it on the Personal dictionary screen.</string>
    <!-- Option to pause learning of personal words and word pairs. ON means nothing new is learned; what is already saved keeps appearing. -->
    <string name="incognito_mode">Incognito mode</string>
    <!-- Description for the incognito option. Says both halves of the contract: learning pauses completely, saved content stays visible. -->
    <string name="incognito_mode_summary">Pause learning new words and word pairs. What is already saved keeps appearing. Turning this off resumes learning.</string>
    <!-- Entry row leading to the screen with the words the keyboard has saved -->
    <string name="personal_dictionary_screen">Saved words</string>
    <!-- Hint of the search field on the personal dictionary screen -->
    <string name="personal_dictionary_search_hint">Search saved words</string>
    <!-- Row that opens a dialog for adding one word by hand -->
    <string name="personal_dictionary_add">Add word\u2026</string>
    <!-- Hint of the text field in the add-word dialog -->
    <string name="personal_dictionary_add_hint">Word</string>
    <!-- Affirmative button of the add-word dialog -->
    <string name="personal_dictionary_add_action">Add</string>
    <!-- Shown when the typed word cannot go into the Tatar personal dictionary -->
    <string name="personal_dictionary_add_rejected">This word cannot be saved: use 3 to 24 Tatar letters, without digits or punctuation.</string>
    <!-- Shown when the typed word cannot go into the Russian personal dictionary -->
    <string name="personal_dictionary_add_rejected_ru">This word cannot be saved: use 3 to 24 Russian letters, without digits or punctuation.</string>
    <!-- Action that removes one saved word -->
    <string name="personal_dictionary_delete">Delete</string>
    <!-- Title of the dialog confirming removal of one word. %1$s is the word itself. -->
    <string name="personal_dictionary_forget_title">Forget \u201c%1$s\u201d?</string>
    <!-- Count of saved words at the head of one language's words card -->
    <plurals name="personal_dictionary_words_count">
        <item quantity="one">%1$d word</item>
        <item quantity="other">%1$d words</item>
    </plurals>
    <!-- Count of learned word pairs at the head of one language's pairs card -->
    <plurals name="personal_dictionary_pairs_count">
        <item quantity="one">%1$d word pair</item>
        <item quantity="other">%1$d word pairs</item>
    </plurals>
    <!-- How often a saved word or pair earned its place, beside its row. Every form carries the number so the translations agree on the arguments. -->
    <plurals name="personal_dictionary_usage_count">
        <item quantity="one">%1$d use</item>
        <item quantity="other">%1$d uses</item>
    </plurals>
    <!-- Small note atop the personal dictionary screen while incognito mode is on. Says the pause out loud where the learned content is managed. -->
    <string name="personal_dictionary_learning_paused">Learning is paused while incognito mode is on. What is already saved still appears.</string>
    <!-- Action inside one language's words card: erase every saved word of that language -->
    <string name="personal_dictionary_clear_words">Clear all words</string>
    <!-- Body of the per-language clear-words confirmation. %1$s is the language name. -->
    <string name="personal_dictionary_clear_words_confirm">Remove every saved word in %1$s? This cannot be undone.</string>
    <!-- Action inside one language's pairs card: erase every learned word pair of that language -->
    <string name="personal_dictionary_clear_pairs">Clear all word pairs</string>
    <!-- Body of the per-language clear-pairs confirmation. %1$s is the language name. -->
    <string name="personal_dictionary_clear_pairs_confirm">Remove every learned word pair in %1$s? This cannot be undone.</string>
    <!-- Title of the dialog confirming removal of one pair. %1$s is the context word, %2$s the word that followed it — the pair reads "A → B", exactly like its row on the screen. -->
    <string name="personal_dictionary_pair_forget_title">Forget \u201c%1$s → %2$s\u201d?</string>
    <!-- Shown when a pair the user asked to remove is still saved -->
    <string name="personal_dictionary_pair_delete_failed">Could not remove the pair. It is still saved.</string>
    <!-- Row and dialog title for erasing every saved word and word pair of every language -->
    <string name="personal_dictionary_erase_all">Erase everything saved</string>
    <!-- Body of the erase-everything dialog. Names both stores: the learned pairs go with the words. -->
    <string name="personal_dictionary_erase_confirm">Remove every word and word pair saved on this device, in all languages? This cannot be undone.</string>
    <!-- Affirmative button of the erase-everything dialog. Names the action rather than saying OK: it is destructive and irreversible. -->
    <string name="personal_dictionary_erase_action">Erase</string>
    <!-- Shown when nothing has been saved yet -->
    <string name="personal_dictionary_empty">No saved words yet. Words you type are saved here once the personal dictionary is on.</string>
    <!-- Shown when the search matches nothing -->
    <string name="personal_dictionary_no_matches">No words match your search.</string>
    <!-- Says how many of the matching words are actually listed. %1$d is shown, %2$d is the total. -->
    <string name="personal_dictionary_shown_of_total">Showing %1$d of %2$d. Use search to narrow the list.</string>
    <!-- Shown when a word the user asked to save did not reach the device. Names no file, no code and no cause: none of that is anything the user could act on. -->
    <string name="personal_dictionary_save_failed">Could not save the word. Try again.</string>
    <!-- Shown when a word the user asked to remove is still saved -->
    <string name="personal_dictionary_delete_failed">Could not remove the word. It is still saved.</string>
    <!-- Shown when erasing every saved word did not remove everything -->
    <string name="personal_dictionary_erase_failed">Could not erase everything. Some saved words are still on this device.</string>
    <!-- Shown once when the saved words could not be read, so the list appears empty -->
    <string name="personal_dictionary_unreadable">Saved words could not be read, so the list is empty. A copy was kept \u2014 open Saved words to bring back what can still be read.</string>
    <!-- Shown once when the learned word pairs could not be read, so next-word predictions from them stop -->
    <string name="personal_bigrams_unreadable">Learned word pairs could not be read, so predictions from them stop. A copy was kept on this device.</string>
    <!-- Title of the card offering the kept copy of words that could not be read. Says what happened, not why. -->
    <string name="personal_dictionary_quarantine_title">Words that could not be read</string>
    <!-- Beside the title when part of the copy is damaged. The count is what was READ, and the damage must be said in the same breath: a partial recovery presented as a whole one is the outcome this feature must never produce. -->
    <plurals name="personal_dictionary_quarantine_partial">
        <item quantity="one">%1$d word can be brought back. The rest of the copy is damaged and cannot be recovered.</item>
        <item quantity="other">%1$d words can be brought back. The rest of the copy is damaged and cannot be recovered.</item>
    </plurals>
    <!-- Beside the title when the whole copy could be read -->
    <plurals name="personal_dictionary_quarantine_whole">
        <item quantity="one">%1$d word can be brought back.</item>
        <item quantity="other">%1$d words can be brought back.</item>
    </plurals>
    <!-- Beside the title when nothing at all could be read out of the copy. It is still offered, because the copy is still on the device and the user is entitled to remove it. -->
    <string name="personal_dictionary_quarantine_none">None of these words can be brought back. The copy is still on this device.</string>
    <!-- Action that puts the readable words back into the saved list -->
    <string name="personal_dictionary_quarantine_restore">Bring the words back</string>
    <!-- Action that removes the kept copy -->
    <string name="personal_dictionary_quarantine_discard">Delete the copy</string>
    <!-- Body of the confirmation dialog for deleting the kept copy -->
    <string name="personal_dictionary_quarantine_discard_confirm">Remove the copy of the words that could not be read? This cannot be undone.</string>
    <!-- Shown when bringing the words back did not happen. Says where the words are now. -->
    <string name="personal_dictionary_quarantine_restore_failed">Could not bring the words back. They are still only in the copy.</string>
    <!-- Shown when the copy could not be removed -->
    <string name="personal_dictionary_quarantine_discard_failed">Could not delete the copy. It is still on this device.</string>
    <!-- Title of the card offering the kept copy of word pairs that could not be read. Says what happened, not why. -->
    <string name="personal_bigrams_quarantine_title">Word pairs that could not be read</string>
    <!-- Beside the title when part of the pairs copy is damaged. The count and the damage are said in the same breath, exactly like the words card. -->
    <plurals name="personal_bigrams_quarantine_partial">
        <item quantity="one">%1$d pair can be brought back. The rest of the copy is damaged and cannot be recovered.</item>
        <item quantity="other">%1$d pairs can be brought back. The rest of the copy is damaged and cannot be recovered.</item>
    </plurals>
    <!-- Beside the title when the whole pairs copy could be read -->
    <plurals name="personal_bigrams_quarantine_whole">
        <item quantity="one">%1$d pair can be brought back.</item>
        <item quantity="other">%1$d pairs can be brought back.</item>
    </plurals>
    <!-- Beside the title when nothing at all could be read out of the pairs copy. It is still offered, because the copy is still on the device and the user is entitled to remove it. -->
    <string name="personal_bigrams_quarantine_none">None of these pairs can be brought back. The copy is still on this device.</string>
    <!-- Action that puts the readable pairs back into the learned list -->
    <string name="personal_bigrams_quarantine_restore">Bring the pairs back</string>
    <!-- Action that removes the kept pairs copy -->
    <string name="personal_bigrams_quarantine_discard">Delete the copy</string>
    <!-- Body of the confirmation dialog for deleting the kept pairs copy -->
    <string name="personal_bigrams_quarantine_discard_confirm">Remove the copy of the word pairs that could not be read? This cannot be undone.</string>
    <!-- Shown when bringing the pairs back did not happen. Says where the pairs are now. -->
    <string name="personal_bigrams_quarantine_restore_failed">Could not bring the pairs back. They are still only in the copy.</string>
    <!-- Shown when the pairs copy could not be removed -->
    <string name="personal_bigrams_quarantine_discard_failed">Could not delete the copy. It is still on this device.</string>
    <!-- Title of the settings item and its confirmation dialog that erases recently used emoji -->
    <string name="clear_recent_emoji">Clear recent emoji</string>
    <!-- Body of the confirmation dialog that erases recently used emoji -->
    <string name="clear_recent_emoji_confirm">Remove all recently used emoji stored on this device? This cannot be undone.</string>
    <!-- Affirmative button of the clear-recent-emoji dialog. Names the action rather than saying OK: the action is destructive and irreversible. -->
    <string name="clear_recent_emoji_action">Clear</string>
    <!-- Title of the preference item that opens the keyboard languages screen -->
    <string name="keyboard_languages">Keyboard languages</string>
    <!-- Summary of the preference item that opens the keyboard languages screen -->
    <string name="keyboard_languages_summary">Add or remove languages</string>
    <string name="user_languages">Enabled keyboard languages</string>
    <string name="add_language">Add language</string>
    <string name="remove_language">Remove language</string>
    <string name="generic_language_layouts"><xliff:g id="LANGUAGE_NAME" example="English (US)">%s</xliff:g> keyboard layouts</string>
    <string name="change_keyboard">Change keyboard</string>
    <string name="privacy_policy">Privacy Policy</string>
    <string name="license">License</string>
    <!-- Shown when a long press lands on a word the keyboard did not learn from you. The word itself is never named: the message can appear over any app. -->
    <string name="personal_dictionary_not_saved">This word comes from the built-in dictionary. Only words the keyboard saved from your own typing can be forgotten.</string>
    <!-- Shown when the emoji key or the search pill has nothing to open. Names no file and no cause. -->
    <string name="emoji_unavailable">Emoji are not available right now. Restarting the keyboard may help.</string>
    <!-- Shown when a link row is tapped and no app on the device can open links. -->
    <string name="no_app_for_link">No app on this device can open links.</string>
    <!-- Shown when nothing has been saved yet AND the personal dictionary is already on, so there is nothing for the person to switch. -->
    <string name="personal_dictionary_empty_ready">No saved words yet. Words you type will appear here.</string>
    <!-- Shown when a long press asks to forget a word while saved words are switched off. Names the switch, because turning it on is the only thing the person can do about it. -->
    <string name="personal_dictionary_off_nothing_to_forget">Saved words are off, so there is nothing to forget. Turn on Personal dictionary in the keyboard settings to have the words you type remembered.</string>
    <!-- Title of the settings row and screen that lists where the keyboard's language data comes from. -->
    <string name="settings_screen_data_sources">Data sources</string>
    <!-- Opening line of the Data sources screen. Says the two things a person actually wants to know: nothing leaves the phone, and the words came from somewhere nameable. -->
    <string name="data_sources_intro">The keyboard works offline and sends nothing anywhere. Its word lists and next-word suggestions are built from open collections of text. These are the collections.</string>
    <!-- Section header above the sources whose data is inside this version of the app. -->
    <string name="data_sources_in_app">In this version</string>
    <string name="data_sources_leipzig_summary">Most of both word lists and both next-word tables. CC BY 4.0.</string>
    <string name="data_sources_tatoeba_summary">Everyday words in both lists, and parts of both next-word tables: frequencies from example sentences. CC BY 2.0 FR.</string>
    <string name="data_sources_opensubtitles_summary">Everyday words in both lists, and parts of both next-word tables: frequencies from film subtitles.</string>
</resources>
