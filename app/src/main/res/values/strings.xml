    <!-- Theme name in the Appearance picker: the fixed palette the app ships with. -->
    <string name="keyboard_theme_classic">Classic</string>
    <!-- Theme name in the Appearance picker: the palette follows the wallpaper colors. -->
    <string name="keyboard_theme_dynamic">Dynamic (Material You)</string>
