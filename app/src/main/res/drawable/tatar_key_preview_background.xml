<!-- Key preview balloon: no state selector needed (the preview has no pressed
     state). Size and bottom padding mirror keyboard_key_feedback_background so
     the preview text keeps its position above the key. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tatar_key_shadow" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tatar_key_normal" />
            <size
                android:height="5dp"
                android:width="45dp" />
            <padding
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="60dp" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
