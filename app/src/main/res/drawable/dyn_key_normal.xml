<!-- Dynamic-theme twin of ios_key_normal: identical geometry and state logic, colors from the
     dyn_* set. The contract test pins the two files equal modulo the color prefix. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sticky keys (caps-locked shift): distinct highlighted fill so the
         locked state is visible in both light and dark palettes. -->
    <!-- Action keys (Go, Search, Send, Done, Next, Previous, custom label) carry
         state_active and are painted in the action accent; the fill is the AA-safe accent so
         the contrasting label keeps its contrast.
         A plain Return is a functional gray key and never reaches this item. -->
    <item android:state_active="true">
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_action_fill" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_checkable="true" android:state_checked="true">
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_checked" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_normal_pressed" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_normal" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
