<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sticky keys (caps-locked shift): distinct highlighted fill so the
         locked state is visible in both light and dark palettes. -->
    <!-- M4 (docs/APPLE-UX-2026-09-25.md): ACTION keys (Go, Search, Send, Done, Next,
         Previous, custom label) carry state_active and are painted in the accent colour, the
         way iOS paints an actionable Return. A plain Return is a functional grey key and never
         reaches this item. -->
    <item android:state_active="true">
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/app_accent" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_checkable="true" android:state_checked="true">
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_checked" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_normal_pressed" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_normal" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
