<!-- Dynamic-theme twin of ios_key_preview_background: identical geometry, colors from the
     dyn_* set. The contract test pins the two files equal modulo the color prefix. In the
     running keyboard the preview is the path-drawn balloon (KeyPreviewChoreographer swaps it
     in for this resource id, as for the ios twin). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dyn_key_shadow" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dyn_key_normal" />
            <size
                android:height="5dp"
                android:width="45dp" />
            <padding
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="60dp" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
