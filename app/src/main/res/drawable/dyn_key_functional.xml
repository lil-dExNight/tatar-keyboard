<!-- Dynamic-theme twin of ios_key_functional: identical geometry and state logic, colors from
     the dyn_* set. The contract test pins the two files equal modulo the color prefix. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sticky keys (shift on, caps locked): the key inverts to the letter-key surface
         instead of turning a darker gray. -->
    <item android:state_checkable="true" android:state_checked="true">
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_sticky_on" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_functional_pressed" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dyn_key_functional" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
