<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sticky keys (shift on, caps locked): M1 of docs/APPLE-UX-2026-09-25.md — iOS
         INVERTS the key to the letter-key surface (white in light, key grey in dark)
         instead of tinting it a darker grey. -->
    <item android:state_checkable="true" android:state_checked="true">
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_sticky_on" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_functional_pressed" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_shadow" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios_key_functional" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
