<!-- More-keys panel background for the Tatar theme: 5dp corner radius, like the
     other ios_* key drawables; 5dp padding must match
     keyboard_popup_panel_background — the panel key insets depend on it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid
        android:color="?attr/popupPanelBackgroundColor" />
    <padding android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp" />
    <corners android:radius="5dp" />
</shape>
