<?xml version="1.0" encoding="utf-8"?>
<!--
  M1 of docs/APPLE-UX-2026-09-25.md: the ONE-SHOT shift state. iOS shows a FILLED arrow
  WITHOUT the caps-lock bar on a white key; the bar belongs to caps lock only
  (sym_keyboard_shift_locked), and the hollow outline belongs to shift-off
  (sym_keyboard_shift). Geometry is the locked icon's arrow path verbatim, minus the bar,
  so the three states share one silhouette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="?attr/functionalTextColor"
        android:strokeColor="?attr/functionalTextColor"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:pathData="M 12,4.5 4.5,12.5 h 4 v 6.5 h 7 v -6.5 h 4 z"/>
</vector>
