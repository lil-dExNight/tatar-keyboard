<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- Tablet variant of the Tatar rows: the qwerty-family tablet pattern. The letter
         keys narrow to a phone-like absolute size (8%p; 7.5%p on the third row, where the
         punctuation keys join), delete and Enter take the right edges of the first two
         rows, and the bottom row is the shared @xml/row_qwerty4 — Enter lives in the
         second row here, exactly as on the tablet QWERTY. Row budgets: extra row
         26+6*8+26, first 11*8+12, second 4+11*8+8, third 9+9*7.5+2*7.5+8.5 = 100%p. -->
    <!-- Extra row: the six Tatar letters, centered at the common pitch. -->
    <Row>
        <include
            latin:keyboardLayout="@xml/rowkeys_tatar_extra"
            latin:keyXPos="26%p"
            latin:keyWidth="8.0%p" />
    </Row>
    <!-- First row -->
    <Row>
        <include
            latin:keyboardLayout="@xml/rowkeys_tatar1"
            latin:keyWidth="8.0%p" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
    <!-- Second row -->
    <Row>
        <include
            latin:keyboardLayout="@xml/rowkeys_tatar2"
            latin:keyXPos="4.0%p"
            latin:keyWidth="8.0%p" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
    <!-- Third row -->
    <Row>
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyWidth="9.0%p" />
        <include
            latin:keyboardLayout="@xml/rowkeys_tatar3"
            latin:keyWidth="7.5%p" />
        <include
            latin:keyboardLayout="@xml/keys_exclamation_question"
            latin:keyWidth="7.5%p" />
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
    <!-- Fourth row -->
    <include
        latin:keyboardLayout="@xml/row_qwerty4" />
</merge>
