<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- Tablet variant of the Russian rows: the same pattern as the tablet
         rows_tatar.xml (see the budget comment there), minus the extra Tatar row. -->
    <!-- First row -->
    <Row>
        <include
            latin:keyboardLayout="@xml/rowkeys_russian1"
            latin:keyWidth="8.0%p" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
    <!-- Second row -->
    <Row>
        <include
            latin:keyboardLayout="@xml/rowkeys_russian2"
            latin:keyXPos="4.0%p"
            latin:keyWidth="8.0%p" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
    <!-- Third row -->
    <Row>
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyWidth="9.0%p" />
        <include
            latin:keyboardLayout="@xml/rowkeys_russian3"
            latin:keyWidth="7.5%p" />
        <include
            latin:keyboardLayout="@xml/keys_exclamation_question"
            latin:keyWidth="7.5%p" />
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
    <!-- Fourth row -->
    <include
        latin:keyboardLayout="@xml/row_qwerty4" />
</merge>
