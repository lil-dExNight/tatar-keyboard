<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- Планшетный нижний ряд кириллических раскладок: xml-sw600dp/row_qwerty4.xml,
         в котором <Spacer> заменён клавишей Enter.

         Почему Enter именно здесь, а не во втором ряду, как у планшетной QWERTY:
         у tatar и russian нет планшетных rows_*.xml, они берут базовые — те же,
         что на телефоне. Класть Enter на его телефонное место дешевле и не ломает
         мышечную память; переносить его в ряд выше пришлось бы вместе с полной
         планшетной копией обоих rows_*.xml, а это второй экземпляр раскладки,
         который будет расходиться с первым.

         Сумма ширин сохранена без пересчёта: 10 + 9 + 63 + 9 + 9 = 100 %p
         (инвариант записан в key_space_7kw.xml). Enter занимает ровно те 9 %p,
         которые в латинском варианте отданы <Spacer>. Фон клавиши задан её
         собственным стилем (defaultEnterKeyStyle, backgroundType="action") и не
         наследует functional-фон ряда. -->
    <Row
        latin:keyWidth="9.0%p"
        latin:backgroundType="functional"
    >
        <Key
            latin:keyStyle="toSymbolKeyStyle"
            latin:keyWidth="10.0%p" />
        <include
            latin:keyboardLayout="@xml/key_comma" />
        <!-- Space key. -->
        <include
            latin:keyboardLayout="@xml/key_space_7kw"
            latin:backgroundType="normal" />
        <include
            latin:keyboardLayout="@xml/key_period" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
</merge>
