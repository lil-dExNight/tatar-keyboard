<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- Tablet bottom row of the Cyrillic layouts: xml-sw600dp/row_qwerty4.xml with
         its <Spacer> replaced by an Enter key.

         Enter goes here rather than into the second row (as on the tablet QWERTY)
         because tatar and russian have no tablet rows_*.xml and use the phone ones.
         Keeping Enter at its phone position keeps muscle memory; moving it up a row
         would need a full tablet copy of both rows_*.xml, a second copy of each
         layout that would drift from the first.

         The widths still total 10 + 9 + 63 + 9 + 9 = 100 %p (the invariant is stated
         in key_space_7kw.xml): Enter takes exactly the 9 %p that the Latin variant
         gives to <Spacer>. The key's background comes from its own style
         (defaultEnterKeyStyle, backgroundType="action"), not from the row's
         functional background. -->
    <Row
        latin:keyWidth="9.0%p"
        latin:backgroundType="functional"
    >
        <Key
            latin:keyStyle="toSymbolKeyStyle"
            latin:keyWidth="10.0%p" />
        <include
            latin:keyboardLayout="@xml/key_comma" />
        <include
            latin:keyboardLayout="@xml/key_space_7kw"
            latin:backgroundType="normal" />
        <include
            latin:keyboardLayout="@xml/key_period" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
</merge>
