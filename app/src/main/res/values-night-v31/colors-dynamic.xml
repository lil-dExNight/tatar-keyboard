<!-- Dark uiMode tier of the dynamic theme, API 31+. The dark roles of the slot mapping are
     documented in the light tier (values-v31/colors-dynamic.xml): the surfaces sink to the
     dark neutral2 tones, the accent inverts to the light accent1_100 tone, and the ink on it
     goes dark. -->
<resources>
    <color name="dyn_keyboard_background">@android:color/system_neutral2_800</color>
    <color name="dyn_key_normal">@android:color/system_neutral2_600</color>
    <color name="dyn_key_normal_pressed">@android:color/system_neutral2_500</color>
    <color name="dyn_key_functional">@android:color/system_neutral2_700</color>
    <color name="dyn_key_functional_pressed">@android:color/system_neutral2_500</color>
    <color name="dyn_key_checked">@android:color/system_neutral2_500</color>
    <color name="dyn_key_sticky_on">@android:color/system_neutral2_600</color>
    <color name="dyn_key_spacebar">@android:color/system_neutral2_600</color>
    <color name="dyn_key_spacebar_pressed">@android:color/system_neutral2_500</color>
    <color name="dyn_key_shadow">#B3000000</color>
    <color name="dyn_popup_key_pressed">@android:color/system_accent1_100</color>
    <color name="dyn_key_text_color">@android:color/system_neutral1_0</color>
    <color name="dyn_key_functional_text_color">@android:color/system_neutral1_0</color>
    <color name="dyn_key_action_fill">@android:color/system_accent1_100</color>
    <color name="dyn_key_action_text_color">@android:color/system_neutral1_900</color>
    <color name="dyn_key_text_inactive_color">#E6FFFFFF</color>
    <color name="dyn_key_hint_color">#E6FFFFFF</color>
    <color name="dyn_suggestion_emphasis">@android:color/system_accent1_100</color>
    <color name="dyn_glide_trail">@android:color/system_accent1_100</color>
</resources>
