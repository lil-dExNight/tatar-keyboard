<resources>
    <!-- Color resources for iOS-style Tatar theme (dark). -->
    <color name="ios_keyboard_background">#2C2C2C</color>
    <color name="ios_keyboard_background_secondary">#3A3A3A</color>
    <color name="ios_key_normal">#6B6B6B</color>
    <color name="ios_key_normal_pressed">#7D7D7D</color>
    <color name="ios_key_functional">#474747</color>
    <color name="ios_key_functional_pressed">#8E8E8E</color>
    <color name="ios_key_checked">#9A9A9A</color>
    <!-- M1: dark mode inverts to the letter-key grey, not to white. -->
    <color name="ios_key_sticky_on">#6B6B6B</color>
    <color name="ios_key_spacebar">#6B6B6B</color>
    <color name="ios_key_spacebar_pressed">#7D7D7D</color>
    <color name="ios_key_shadow">#B3000000</color>
    <!-- Slide-to-select highlight on the more-keys panel: must clearly differ
         from ios_keyboard_background_secondary (the panel fill). -->
    <!-- M3: the accent of the dark palette highlights the selected alternative. -->
    <color name="ios_popup_key_pressed">@color/app_accent</color>
    <color name="ios_popup_key_selected_text">#FFFFFF</color>
    <color name="ios_key_text_color">#FFFFFF</color>
    <color name="ios_key_functional_text_color">#FFFFFF</color>
    <!-- M4: white reads on the accent fill in the dark palette too. -->
    <color name="ios_key_action_text_color">#FFFFFF</color>
    <color name="ios_key_text_inactive_color">#80FFFFFF</color>
    <color name="ios_key_hint_color">#B2FFFFFF</color>

    <!-- Color resources for iOS-style app screens (dark). App-screen palette,
         kept separate from the keyboard ios_* colors above. -->
    <color name="app_screen_bg">#000000</color>
    <color name="app_card_bg">#1C1C1E</color>
    <color name="app_text_primary">#FFFFFF</color>
    <color name="app_text_secondary">#98989E</color>
    <color name="app_separator">#38383A</color>
    <color name="app_accent">#0A84FF</color>
    <color name="app_accent_pressed">#0A76E6</color>
    <color name="app_accent_disabled">#660A84FF</color>
    <color name="app_switch_on">#30D158</color>
    <color name="app_switch_off">#39393D</color>
</resources>
