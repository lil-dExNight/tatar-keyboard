<!-- Fifth-row experiment, arm C: incumbent desktop scan order. Same six keys
     as xml/rowkeys_tatar_extra.xml (arm A), reordered; the order is pinned by
     FifthRowArmTest. -->
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- U+04BB: "һ" CYRILLIC SMALL LETTER SHHA -->
    <Key
        latin:keySpec="&#x04BB;" />
    <!-- U+04E9: "ө" CYRILLIC SMALL LETTER BARRED O -->
    <Key
        latin:keySpec="&#x04E9;" />
    <!-- U+04D9: "ә" CYRILLIC SMALL LETTER SCHWA -->
    <Key
        latin:keySpec="&#x04D9;" />
    <!-- U+04AF: "ү" CYRILLIC SMALL LETTER STRAIGHT U -->
    <Key
        latin:keySpec="&#x04AF;" />
    <!-- U+04A3: "ң" CYRILLIC SMALL LETTER EN WITH DESCENDER -->
    <Key
        latin:keySpec="&#x04A3;" />
    <!-- U+0497: "җ" CYRILLIC SMALL LETTER ZHE WITH DESCENDER -->
    <Key
        latin:keySpec="&#x0497;" />
</merge>
