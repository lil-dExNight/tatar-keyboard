<?xml version="1.0" encoding="utf-8"?>
<!--
     Backup and device transfer closed as a whitelist, API 31+ (android:dataExtractionRules).

     Neither section has an allowing <include> element. Every data domain of the app,
     regular and device-protected (files, SharedPreferences, databases, external storage),
     is excluded whole, with no path attribute, so any file added later falls into an
     already-excluded domain. Individual paths (personal/, dictionaries/, recent emoji)
     are deliberately not listed: a path list would miss new files.

     Both sections are needed. On Android 12+ android:allowBackup="false" stops cloud
     backup but not device-to-device transfer, so <device-transfer> excludes the same
     domains as <cloud-backup>.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
