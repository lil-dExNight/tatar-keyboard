<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- Bottom row of the Cyrillic layouts (tatar, russian).

         On the phone it is the same row as in the Latin layouts, so this file
         delegates to it instead of copying it.

         The file exists for the sw600dp variant next to it. The tablet
         xml-sw600dp/row_qwerty4.xml ends with a <Spacer> because the tablet QWERTY
         moves Enter to the second row in its own xml-sw600dp/rows_qwerty.xml.
         tatar and russian have no tablet rows_*.xml: they use the base
         xml/rows_tatar.xml and xml/rows_russian.xml, which contain no
         enterKeyStyle, so Enter can only come from this row. Without the sw600dp
         variant both Cyrillic layouts would have no Enter key at smallest
         width >= 600dp. -->
    <include
        latin:keyboardLayout="@xml/row_qwerty4" />
</merge>
