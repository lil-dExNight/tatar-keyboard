<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- Нижний ряд кириллических раскладок (tatar, russian).

         На телефоне он ровно тот же, что у латинских раскладок, поэтому здесь
         делегирование, а не копия: одна точка правды, дрейфовать нечему.

         Файл заведён ради sw600dp-варианта рядом. Планшетный
         xml-sw600dp/row_qwerty4.xml заканчивается <Spacer>, потому что
         планшетная QWERTY уносит Enter во ВТОРОЙ ряд собственным
         xml-sw600dp/rows_qwerty.xml. У tatar и russian планшетных rows_*.xml
         нет — они берут базовые xml/rows_tatar.xml и xml/rows_russian.xml, где
         enterKeyStyle не встречается ни разу: Enter приходил к ним только
         отсюда. В итоге при smallest width >= 600dp обе кириллические раскладки
         оставались вообще без Enter — дефект Д-2, docs/DEVICE-UAT-1.9.12.md. -->
    <include
        latin:keyboardLayout="@xml/row_qwerty4" />
</merge>
