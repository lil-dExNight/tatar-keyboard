<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- Fifth row on TOP: ә ө ү җ ң һ ё ъ — 8 keys × 12.5%p = 100%. The eight keys are the
         Tatar letters the three ЙЦУКЕН rows do not carry directly, so every one of the 39
         Tatar alphabet letters has its own key; ё and ъ keep their long-press duplicates on
         е and ь. OneHandedMode.FIFTH_ROW_KEY_FRACTION mirrors this row's pitch. -->
    <Row
        latin:keyWidth="12.5%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_tatar_extra" />
    </Row>
    <Row
        latin:keyWidth="9.091%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_tatar1" />
    </Row>
    <Row
        latin:keyWidth="9.091%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_tatar2" />
    </Row>
    <Row
        latin:keyWidth="8.711%p"
    >
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyWidth="10.8%p" />
        <include
            latin:keyboardLayout="@xml/rowkeys_tatar3" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
    <include
        latin:keyboardLayout="@xml/row_qwerty4" />
</merge>
