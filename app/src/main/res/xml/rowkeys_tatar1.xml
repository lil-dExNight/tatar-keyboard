<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- U+0439: "й" CYRILLIC SMALL LETTER SHORT I -->
    <Key
        latin:keySpec="&#x0439;" />
    <!-- U+0446: "ц" CYRILLIC SMALL LETTER TSE -->
    <Key
        latin:keySpec="&#x0446;" />
    <!-- U+0443: "у" CYRILLIC SMALL LETTER U; long-press U+04AF: "ү" -->
    <Key
        latin:keySpec="&#x0443;"
        latin:keyHintLabel="&#x04AF;"
        latin:moreKeys="&#x04AF;" />
    <!-- U+043A: "к" CYRILLIC SMALL LETTER KA -->
    <Key
        latin:keySpec="&#x043A;" />
    <!-- U+0435: "е" CYRILLIC SMALL LETTER IE; long-press U+0451: "ё" -->
    <Key
        latin:keySpec="&#x0435;"
        latin:keyHintLabel="&#x0451;"
        latin:moreKeys="&#x0451;" />
    <!-- U+043D: "н" CYRILLIC SMALL LETTER EN; long-press U+04A3: "ң" -->
    <Key
        latin:keySpec="&#x043D;"
        latin:keyHintLabel="&#x04A3;"
        latin:moreKeys="&#x04A3;" />
    <!-- U+0433: "г" CYRILLIC SMALL LETTER GHE; long-press U+04BB: "һ" -->
    <Key
        latin:keySpec="&#x0433;"
        latin:keyHintLabel="&#x04BB;"
        latin:moreKeys="&#x04BB;" />
    <!-- U+0448: "ш" CYRILLIC SMALL LETTER SHA -->
    <Key
        latin:keySpec="&#x0448;" />
    <!-- U+0449: "щ" CYRILLIC SMALL LETTER SHCHA -->
    <Key
        latin:keySpec="&#x0449;" />
    <!-- U+0437: "з" CYRILLIC SMALL LETTER ZE -->
    <Key
        latin:keySpec="&#x0437;" />
    <!-- U+0445: "х" CYRILLIC SMALL LETTER HA; long-press U+04BB: "һ" -->
    <Key
        latin:keySpec="&#x0445;"
        latin:keyHintLabel="&#x04BB;"
        latin:moreKeys="&#x04BB;" />
</merge>
