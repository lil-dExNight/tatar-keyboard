<!-- Russian overlay of the onboarding strings. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="setup_subtitle">Два быстрых шага — и можно печатать по-татарски</string>

    <string name="setup_step1_title">Включить клавиатуру</string>
    <string name="setup_step1_instruction">Включите „<xliff:g id="KEYBOARD_NAME" example="Tatar Keyboard">%s</xliff:g>“ в списке клавиатур системы</string>
    <string name="setup_step1_note">Android показывает это предупреждение для любой сторонней клавиатуры. Эта клавиатура работает полностью без интернета: у неё нет разрешения INTERNET, поэтому напечатанное не покидает устройство.</string>
    <string name="setup_step1_button">Включить клавиатуру</string>

    <string name="setup_step2_title">Выбрать клавиатуру</string>
    <string name="setup_step2_instruction">Выберите эту клавиатуру текущим способом ввода</string>
    <string name="setup_step2_button">Выбрать клавиатуру</string>

    <string name="setup_done_title">Готово!</string>
    <string name="setup_status_title">Клавиатура активна</string>
    <string name="setup_done_hint">Работает и набор свайпом: ведите по буквам, не отрывая палец</string>
    <string name="setup_test_field_hint">Попробуйте: проведите по буквам „сәләм“</string>
    <string name="setup_done_button">Открыть настройки</string>

    <string name="setup_step_status_done">Шаг выполнен</string>
    <string name="setup_step_status_pending">Шаг не выполнен</string>

    <string name="setup_error_no_settings">Откройте настройки и включите эту клавиатуру в списке клавиатур вручную</string>
</resources>
