<!-- Russian overlay of the onboarding strings. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="setup_subtitle">Два быстрых шага — и можно печатать по-татарски</string>

    <string name="setup_step1_title">Включите клавиатуру</string>
    <string name="setup_step1_instruction">Включите „<xliff:g id="KEYBOARD_NAME" example="Tatar Keyboard">%s</xliff:g>“ в списке клавиатур</string>
    <string name="setup_step1_note">Android показывает предупреждение для любой сторонней клавиатуры. Эта работает без интернета: всё, что вы печатаете, остаётся на телефоне.</string>
    <string name="setup_step1_button">Включить</string>

    <string name="setup_step2_title">Выберите клавиатуру</string>
    <string name="setup_step2_instruction">Сделайте её основной клавиатурой</string>
    <string name="setup_step2_button">Выбрать</string>

    <string name="setup_done_title">Готово!</string>
    <string name="setup_done_hint">Можно печатать и свайпом: ведите пальцем по буквам</string>
    <string name="setup_test_field_hint">Попробуйте: проведите по „сәләм“\nили напечатайте „бел“</string>
    <string name="setup_done_button">Открыть настройки</string>

    <string name="setup_step_status_done">Шаг выполнен</string>
    <string name="setup_step_status_pending">Шаг не выполнен</string>

    <string name="setup_error_no_settings">Откройте настройки телефона и включите там эту клавиатуру</string>
