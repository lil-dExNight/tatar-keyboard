.DS_Store
*.iml
.gradle/
.idea/
build/
local.properties
.kotlin/

# Built application files
*.apk
*.aab
*.ap_
output.json
output-metadata.json

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
# gradle/ is ignored by content (gradle/*, not gradle/): git cannot re-include a file
# whose parent directory is excluded, and the files re-included below must be tracked.
gradle/*
release/
# The release source set (release-only manifest overlay) is source, not build output.
!/app/src/release/
!/gradle/wrapper
gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.properties
# Dependency checksums are the supply-chain pin; they only work if versioned.
!/gradle/verification-metadata.xml
# The exported PGP keyring is versioned so CI and fresh clones verify signatures offline.
!/gradle/verification-keyring.gpg
!/gradle/verification-keyring.keys

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Python tooling caches
__pycache__/
*.py[cod]
.pytest_cache/

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Intellij
.idea/workspace.xml

# Keystore files
*.jks
keystore.properties

.idea

# Local release artifacts (APKs are not committed)
dist/

# Local git worktrees
.wt/

# Local scratch directory (screencasts, drafts)
.temp/

# Tatar Leipzig corpora (licensed dictionary and bigram inputs; not committed).
tat_*.tar.gz
tat_*-words.txt
tat_*-sentences.txt
# Same for the Russian Leipzig corpora (inputs of the Russian bigram table and dictionary).
rus_*.tar.gz
rus_*-words.txt
rus_*-sentences.txt

# docs/ holds Markdown only. Run evidence (screenshots, JSON reports, logs) goes to build/.
docs/**/*
!docs/**/
!docs/**/*.md
# Samples that scripts/dict_accept.py writes next to its inputs.
data/dictionary/dict-accept/sample-*.txt
.smgr/

# Conversational OPUS corpora and their test artifacts. Like tat_*-sentences.txt above,
# these are licensed sources and stay out of the repository; the measurement scripts
# (research/corpus/*.py) are committed, the data is not.
research/corpus/*.txt.gz
research/corpus/*.part
research/corpus/out/
research/corpus/licenses/
research/corpus/__pycache__/
research/corpus/chunks/
