.DS_Store
*.iml
.gradle/
.idea/
build/
local.properties
.kotlin/

# Built application files
*.apk
*.aab
*.ap_
output.json
output-metadata.json

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
# Каталог gradle/ игнорируется ПОСОДЕРЖИМО (gradle/*, а не gradle/): git не умеет
# ре-включать файл, у которого исключён родительский каталог, а два файла ниже обязаны
# лежать в репозитории.
gradle/*
release/
!/gradle/wrapper
gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.properties
# T7 (stage D, docs/ROADMAP-P8-PLAN.md): the dependency checksums must be versioned — they are
# the supply-chain pin itself, useless if only the local machine has them.
!/gradle/verification-metadata.xml

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Python tooling caches
__pycache__/
*.py[cod]
.pytest_cache/

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Intellij
.idea/workspace.xml

# Keystore files
*.jks
keystore.properties

.idea

# Локальные релизные артефакты (APK не коммитим)
dist/

# Локальные git worktree
.wt/

# Рабочий каталог оператора (скринкасты, черновики; не коммитится — ROADMAP-P1 T6)
.temp/

tat_*.tar.gz
tat_*-words.txt
tat_*-sentences.txt
# То же для русских корпусов Leipzig (входы русской таблицы биграмм и словаря).
rus_*.tar.gz
rus_*-words.txt
rus_*-sentences.txt

# Сырые отчёты прогонов (числа переносятся в markdown вручную, сам JSON не коммитится)
docs/*.generated.json
# Уточнение 2026-08-30: три JSON в docs/lang-priority/*.generated.json закоммичены
# осознанно — это пины-свидетельства миссии lang-priority, на них ссылается отчёт.
# Паттерн выше покрывает только верхний уровень docs/ и остаётся в силе.
# Уточнение 2026-08-30 (фаза 2): верхнеуровневые JSON переехали в архив вместе с
# отчётами — покрываем и новое место (трекнутые пины lang-priority оно не затрагивает:
# .gitignore на уже отслеживаемые файлы не действует).
docs/archive/bigrams/*.generated.json
.smgr/

# Разговорные корпуса миссии tt-corpus (OPUS) и её тестовые артефакты.
# Причина та же, по которой выше игнорируются tat_*-sentences.txt: это лицензионные
# исходники, они в репозиторий не кладутся. Числа перенесены в docs/CORPUS.md,
# скрипты замера (research/corpus/*.py) — коммитятся, данные — нет.
research/corpus/*.txt.gz
research/corpus/*.part
research/corpus/out/
research/corpus/licenses/
research/corpus/__pycache__/
research/corpus/chunks/
